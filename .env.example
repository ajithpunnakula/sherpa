# At least one of these is required for live LLM suggestions.
# Without keys, the app runs in "retrieval-only" mode (still useful — shows wiki snippets).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default model overrides (optional)
# ANTHROPIC_MODEL=claude-sonnet-4-6
# OPENAI_MODEL=gpt-4o-mini

# Source repo for the knowledge base. The app reads from this path; it never writes.
COFFEEANDAI_REPO=/Users/aj/code/coffeeandai
